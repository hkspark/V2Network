<configuration>
    <input>
        <net-file value="highway.net.xml"/>
        <route-files value="routes.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="300"/>
        <step-length value="0.1"/>
    </time>

    <processing>
        <collision.action value="warn"/>
        <ignore-route-errors value="true"/>
    </processing>
</configuration>
